#!/usr/bin/make -f

export PYBUILD_NAME=smfc

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_test:
	# Tests require IPMI hardware; skip during package build

override_dh_installsystemd:
	# Enable the service but do not start it on a fresh install; the user must
	# review the configuration first. On upgrade, try-restart the service, so a
	# running service comes back (matches the RPM %systemd_postun_with_restart).
	dh_installsystemd --no-start --restart-after-upgrade

override_dh_builddeb:
	dh_builddeb