#!/bin/sh
set -e

CONF_FILE="/etc/smfc/smfc.conf"

# smfc.discover owns the device filters and the write format, so the installer, this script and the
# RPM script share one implementation. It fills a key only while that key is still empty.
smfc_detect_device_names() {
    python3 -m smfc.discover hd --fill "$CONF_FILE" || true
    python3 -m smfc.discover nvme --fill "$CONF_FILE" || true
}

case "$1" in
    configure)
        # Only auto-detect disks on fresh install (not upgrade)
        if [ -z "$2" ]; then
            smfc_detect_device_names
        fi
        ;;
esac

#DEBHELPER#

exit 0
