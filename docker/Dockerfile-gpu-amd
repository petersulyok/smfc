FROM ubuntu:noble-20260930.1
ARG BUILD_IMAGE_VERSION
LABEL org.opencontainers.image.version=${BUILD_IMAGE_VERSION}
LABEL org.opencontainers.image.title="smfc"
LABEL org.opencontainers.image.authors="petersulyok"
LABEL org.opencontainers.image.desciption="Supermicro fan control for Linux (home) servers."
LABEL org.opencontainers.image.url="https://github.com/petersulyok/smfc"
RUN echo 'APT::Keep-Downloaded-Packages "false";' > /etc/apt/apt.conf.d/01disable-cache
# The index and the packages it feeds belong to one layer. A base image carries no package list, so
# every install needs a fresh one; kept in a layer of its own it would be cached and go stale, and a
# rebuild would then ask the mirror for a point release it has already replaced. The list is 51 MB,
# so it is removed in the same layer that wrote it, where the removal still counts.
# Documentation, manual pages, the IANA vendor table of ipmitool and the test suite of the Python
# standard library are dead weight in a service image, together 7 MB. Every install layer clears its
# own: a file deleted in a later layer is only hidden, its bytes still travel with the image.
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl ca-certificates gnupg && \
    rm -rf /var/lib/apt/lists/* /usr/share/doc /usr/share/man /usr/share/info \
           /usr/share/misc/enterprise-numbers.txt /usr/lib/python3.*/test
# Only `rocm-smi` is needed from ROCm, it is installed from the official AMD package repository.
RUN mkdir -p /etc/apt/keyrings && \
    curl -fsSL https://repo.radeon.com/rocm/rocm.gpg.key | gpg --dearmor -o /etc/apt/keyrings/rocm.gpg && \
    echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/rocm.gpg] https://repo.radeon.com/rocm/apt/7.2.4 noble main" \
      > /etc/apt/sources.list.d/rocm.list
# The second index is needed because the ROCm repository was added above, and its packages are
# invisible until the list is fetched again.
RUN apt-get update && \
    apt-get install -y --no-install-recommends rocm-smi-lib ipmitool python3 libudev1 smartmontools && \
    rm -rf /var/lib/apt/lists/* /usr/share/doc /usr/share/man /usr/share/info \
           /usr/share/misc/enterprise-numbers.txt /usr/lib/python3.*/test
# `rocm-smi` is installed in /opt/rocm/bin, smfc looks for it in /usr/bin (see [GPU] rocm_smi_path=).
RUN ln -s /opt/rocm/bin/rocm-smi /usr/bin/rocm-smi
# smfc lives in its own environment, so nothing is written into the Python of the image. pip brings
# pyudev with it; libudev1 above provides the library that binding reaches through ctypes, and the
# Context() call below proves it before the image is finished. python3-pip is installed, used and
# removed in one layer, otherwise it stays in the image.
RUN apt-get update && \
    apt-get install -y --no-install-recommends python3-pip python3-venv && \
    python3 -m venv --without-pip /opt/smfc/venv && \
    python3 -m pip --python /opt/smfc/venv/bin/python install \
        --no-cache-dir smfc==${BUILD_IMAGE_VERSION%%-amd} && \
    /opt/smfc/venv/bin/python -c "import pyudev; pyudev.Context()" && \
    for cmd in smfc smfc-client smfc-config; do \
        if [ -e /opt/smfc/venv/bin/$cmd ]; then ln -s /opt/smfc/venv/bin/$cmd /usr/bin/$cmd; fi; \
    done && \
    apt-get autoremove --purge -y python3-pip python3-venv curl gnupg && \
    rm -rf /var/lib/apt/lists/* /usr/share/doc /usr/share/man /usr/share/info \
           /usr/share/misc/enterprise-numbers.txt /usr/lib/python3.*/test
ENV ROCM_PATH=/opt/rocm
ENV PATH="/opt/rocm/bin:${PATH}"
ADD --chmod=755 docker/entrypoint.sh /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
